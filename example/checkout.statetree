initialState Initializing

states {
  Initializing {
    validUser => Authenticated
    noUser    => AwaitingEmail
  }
  AwaitingEmail {
    gotEmail => CheckingEmail
  }
  CheckingEmail {
    sentOtp => AwaitingOtp
  }
  AwaitingOtp {
    submit => SubmittingOtp
  }
  SubmittingOtp {
    valid   => Authenticated
    invalid => OtpInvalid
  }
  OtpInvalid {
    resend => RequestingNewOtp
  }
  RequestingNewOtp {
    sentOtp => AwaitingOtp
  }
  Authenticated {
    continueAsGuest => ContinuingAsGuest
  }
  ContinuingAsGuest {}
}
